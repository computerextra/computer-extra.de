  "name": "computer-extra.de",
  "private": true,
  "scripts": {
    "build": "bun run clean && tsc -b && eslint . && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun run generate:sitemap && bun run prerender",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await Promise.all([rm('dist', { recursive: true, force: true }), rm('dist-ssr', { recursive: true, force: true })])\"",
    "dev": "vite",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "generate:sitemap": "bun run scripts/generate-sitemap.ts",
    "lint": "eslint .",
    "prerender": "bun run scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
